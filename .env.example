# Per-install settings for docker-compose.yml. install.sh writes .env for you;
# to set one up by hand: cp .env.example .env && chmod 600 .env
#
# Wrap values in single quotes: Docker Compose then takes them literally, so a
# password may contain $ or #. (It may not contain a single quote.)

CONTAINER_NAME='Timeclock-YourCompany'

# host.docker.internal = MySQL/MariaDB running on this Docker host
DB_HOST='host.docker.internal'
DB_NAME='timeclock-YourCompany'
DB_USER='timeclock'
DB_PASS='change-me'
DB_TIMEZONE='America/Chicago'
